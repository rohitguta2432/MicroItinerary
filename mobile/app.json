{
    "expo": {
        "name": "MicroItinerary",
        "slug": "microitinerary",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "automatic",
        "splash": {
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            },
            "package": "com.microitinerary.mobile"
        },
        "web": {
            "favicon": "./assets/favicon.png",
            "name": "MicroItinerary",
            "shortName": "MicroTrip",
            "description": "Offline-first travel planner",
            "themeColor": "#ffffff",
            "display": "standalone",
            "backgroundColor": "#ffffff"
        },
        "plugins": [
            "expo-router"
        ],
        "scheme": "microitinerary"
    }
}