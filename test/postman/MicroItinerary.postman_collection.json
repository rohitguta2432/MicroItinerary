{
    "info": {
        "_postman_id": "4b6e8f45-6d8a-4b95-9f5b-1c1a1e1e1e1e",
        "name": "MicroItinerary",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Create Trip",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "var jsonData = pm.response.json();",
                            "pm.test(\"Response has ID\", function () {",
                            "    pm.expect(jsonData.id).to.not.be.undefined;",
                            "});",
                            "",
                            "if (jsonData.id) {",
                            "    pm.collectionVariables.set(\"tripId\", jsonData.id);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Test Trip\",\n    \"location\": \"Paris\",\n    \"startDate\": \"2024-06-01\",\n    \"endDate\": \"2024-06-10\",\n    \"travelType\": \"LEISURE\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/trips",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "trips"
                    ]
                }
            },
            "response": []
        },
        {
